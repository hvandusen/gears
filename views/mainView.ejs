<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>gears</title>
<link rel="icon" href="/favicon.ico">
<script src="/jquery-2.0.0.min.js"></script>
<script type="text/javascript" src="/paper.js"></script>
<script type="text/javascript" src="/secondary.js"></script>
<script type="text/paperscript" src='/gearsHen.js' canvas="chillCanv"></script>
<link href="/style.css" media="all" rel="stylesheet">
</head>
  <body>
    <canvas id='chillCanv' ></canvas>
   <a style='background-color:white'> to make a new room, add "/your_room_name" to the url and press enter!!! </a>
<div id='container'>
<% for(var i=0; i<rooms.length; i++) {%>
  <a href='/<%= encodeURIComponent(rooms[i]) %>' class='room'>
  <h3><%= rooms[i] %></h3>
  <% if (imgs[rooms[i]]) { %><img style='width:100%' src='<%= imgs[rooms[i]] %>'><% } %>
 </a>
<% } %>
</div>

    <br>
<script>
list = $('#container')
list.children().each(function(i,li){list.prepend(li)})
</script>
</body>
</html>
